# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="FastAPI Onion DDD Template"
APP_VERSION="1.0.0"
DEBUG=false

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (local development)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# MySQL (alternative)
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/dbname

# ─── Redis (JWT revocation store — logout / refresh token rotation) ───────────
REDIS_URL=redis://localhost:6379/0

# ─── Observability ──────────────────────────────────────────────────────────────
# Structured JSON logging is always on. Tracing is opt-in — enable it once an OTLP
# collector (e.g. the `jaeger` service in docker-compose.yml, UI at :16686) is reachable.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=fastapi-onion-ddd-template
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ─── JWT Authentication ────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-super-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── CORS ──────────────────────────────────────────────────────────────────────
# JSON list of allowed origins. Avoid "*" outside of local experimentation — the
# app disables allow_credentials automatically when this is ["*"], since browsers
# reject wildcard origins on credentialed requests.
ALLOWED_ORIGINS=["http://localhost:3000"]
